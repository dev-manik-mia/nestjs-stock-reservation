# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your environment.
#   cp .env.example .env
# Every variable is validated at startup (src/config/env.validation.ts);
# the app refuses to boot if a required value is missing or malformed.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the API listens on.
PORT=3000

# PostgreSQL connection string used by Prisma (required).
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_reservation?schema=public"

# Maximum attempts for a reservation transaction that fails with a transient
# database error (serialization failure / deadlock). Must be >= 1.
RESERVATION_TX_MAX_ATTEMPTS=3
